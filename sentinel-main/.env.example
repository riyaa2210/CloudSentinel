# Sentinel / CloudSentinel configuration.
#
# Copy this file to `.env` (in the backend/ working directory) or set the same
# variables as environment variables. Demo mode only — no AWS credentials are
# required. docker compose already injects sensible defaults for you.

# PostgreSQL connection string.
DATABASE_URL=postgresql://sentinel:sentinel@db:5432/sentinel

# Anomaly detection: flag costs whose |z-score| exceeds this many std devs.
ANOMALY_Z_SCORE_THRESHOLD=2.0

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
